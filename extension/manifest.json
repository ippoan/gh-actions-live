{
  "manifest_version": 3,
  "name": "GitHub Actions Live",
  "version": "0.0.1",
  "description": "GitHub の Actions ページを起点に alive WebSocket を購読し、repo ごとの列 + run カードで並列表示するアプリ風ウィンドウ",
  "key": "",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "GitHub Actions Live",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  }
}
