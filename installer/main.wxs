<?xml version="1.0" encoding="utf-8"?>
<!--
  1 パッケージで perUser / perMachine の両対応 (Scope="perUserOrMachine")。

    既定 (admin 不要):  msiexec /i gh-actions-live-x.y.z-x64.msi
      - 拡張一式を %LOCALAPPDATA%\Programs\gh-actions-live\extension に置く
        (per-user context では ProgramFiles64Folder がそこへリダイレクトされる)
      - native messaging host (host.bat → host.ps1 → update.ps1) を HKCU に登録。
        ダッシュボードの「更新」ボタンがこれを呼び、extension\ を差し替えて拡張が自分でリロードする
      - Chrome への初回読み込みだけ手動: chrome://extensions → デベロッパーモード →
        「パッケージ化されていない拡張機能を読み込む」→ 上のフォルダ
        (非管理 Windows では Chrome が Web Store 外の force_installed を捨てるため。Refs #9)

    管理端末向け (UAC 昇格):  msiexec /i gh-actions-live-x.y.z-x64.msi ALLUSERS=1 [ENROLLMENTTOKEN=...]
      - C:\Program Files\gh-actions-live に置く
      - HKLM に ExtensionSettings (force_installed) を書く。AD / Entra / Chrome Enterprise Core
        登録済み端末ならこれだけで Chrome に入り、自動更新も Chrome 側で効く
      - ENROLLMENTTOKEN を渡せば Chrome Enterprise Core に登録する

  HKCU\Software\Policies はユーザー権限で書けないので、ポリシー系 component は
  ALLUSERS=1 のときだけ出す。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="GitHub Actions Live"
      Manufacturer="ippoan"
      Version="$(var.Version)"
      UpgradeCode="63AA7341-F629-4E7E-AC1D-CEDB0D51C6F5"
      Scope="perUserOrMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="より新しいバージョンが既にインストールされています。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="gh-actions-live">
        <Directory Id="EXTFOLDER" Name="extension" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ExtensionFiles" Directory="EXTFOLDER">
      <Files Include="..\extension\**" />
    </ComponentGroup>

    <ComponentGroup Id="UpdaterFiles" Directory="INSTALLFOLDER">
      <!-- File/@Source の相対パスは wix build の cwd 基準 (Files/@Include と違う)。wxs の場所に固定する -->
      <Component><File Source="$(sys.SOURCEFILEDIR)update.ps1" KeyPath="yes" /></Component>
      <Component><File Source="$(sys.SOURCEFILEDIR)host.ps1" KeyPath="yes" /></Component>
      <Component><File Source="$(sys.SOURCEFILEDIR)host.bat" KeyPath="yes" /></Component>
      <Component><File Source="$(sys.SOURCEFILEDIR)native-host-manifest.json" KeyPath="yes" /></Component>
    </ComponentGroup>

    <!--
      native messaging host の登録。拡張の「更新」ボタンが chrome.runtime.sendNativeMessage で
      host.bat → host.ps1 → update.ps1 を呼ぶ (拡張はディスクに書けないため)。
      NativeMessagingHosts は Policies 配下ではないので、perUser なら HKCU にユーザー権限で書ける。
      ALLUSERS=1 のときは HKLM (always64 — WOW6432Node に落ちると読まれない)。
      既定値 (Name 無し) に manifest の絶対パスを入れる。
    -->
    <ComponentGroup Id="NativeHost" Directory="INSTALLFOLDER">
      <Component Condition="NOT (ALLUSERS=1)">
        <RegistryValue Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\jp.ippoan.gh_actions_live"
                       Type="string" KeyPath="yes" Value="[INSTALLFOLDER]native-host-manifest.json" />
      </Component>
      <Component Bitness="always64" Condition="ALLUSERS=1">
        <RegistryValue Root="HKLM" Key="Software\Google\Chrome\NativeMessagingHosts\jp.ippoan.gh_actions_live"
                       Type="string" KeyPath="yes" Value="[INSTALLFOLDER]native-host-manifest.json" />
      </Component>
    </ComponentGroup>

    <!--
      更新は「更新」ボタン (native host 経由) か、Linux 側からの bridge コマンドで行う。
      以前あった 1 時間ごとのタスク スケジューラ登録は廃止した。v0.0.10〜0.0.12 が登録した
      タスクが残っている端末のため、install 時に -Unregister で掃除だけする。
      (自分で回したい人は update.ps1 -Register を手で叩けば従来どおり登録できる)
      ExeCommand の [INSTALLFOLDER] は deferred でもスクリプト書き出し時に解決される。
    -->
    <CustomAction Id="UnregisterUpdater" Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]update.ps1&quot; -Unregister"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <!--
      設定の seed。msiexec の property で渡すと extension\config.json に書く:
        msiexec /i gh-actions-live-x.y.z-x64.msi BRIDGEURL=ws://host:8799 REPOS=owner/repo,owner/repo2 NOTIFY=0
      拡張は起動時に自分のフォルダの config.json を読んで設定に取り込む。
      設定画面での手入力が不要になり、拡張を入れ直しても (chrome.storage が消えても) 設定が残る。
      update.ps1 は更新時に config.json を引き継ぐ。
      値が 1 つでも渡されたときだけ走る。upgrade で渡し直せば上書きされる (再設定の手段)。
    -->
    <Property Id="BRIDGEURL" Secure="yes" />
    <Property Id="REPOS" Secure="yes" />
    <Property Id="NOTIFY" Secure="yes" />
    <CustomAction Id="SeedConfig" Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]update.ps1&quot; -Seed -BridgeUrl &quot;[BRIDGEURL]&quot; -Repos &quot;[REPOS]&quot; -Notify &quot;[NOTIFY]&quot;"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterUpdater" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="SeedConfig" After="UnregisterUpdater" Condition="(BRIDGEURL OR REPOS OR NOTIFY) AND NOT REMOVE" />
    </InstallExecuteSequence>

    <!--
      Chrome ポリシー (ALLUSERS=1 のときだけ)。
      ExtensionSettings は `Chrome` キー直下の **単一 REG_SZ に JSON を丸ごと** 入れる形でしか
      読まれない (サブキー形式はレジストリに入るが Chrome が無視する。実機で確認済み)。
      Bitness="always64": 無いと WOW6432Node に落ちて 64bit Chrome が読まない。
      Chrome キーには他ポリシーが同居しうるので ForceDeleteOnUninstall は付けない。
    -->
    <ComponentGroup Id="ChromePolicy" Directory="INSTALLFOLDER">
      <Component Bitness="always64" Condition="ALLUSERS=1">
        <RegistryValue Root="HKLM"
                       Key="Software\Policies\Google\Chrome"
                       Name="ExtensionSettings"
                       Type="string"
                       KeyPath="yes"
                       Value="{&quot;oaadakmclelmnaieokjbhldfacfckaaj&quot;:{&quot;installation_mode&quot;:&quot;force_installed&quot;,&quot;update_url&quot;:&quot;https://github.com/ippoan/gh-actions-live/releases/latest/download/update.xml&quot;}}" />
      </Component>
    </ComponentGroup>

    <!--
      Chrome Enterprise Core への登録 (Refs #9)。ALLUSERS=1 かつ ENROLLMENTTOKEN を渡したときだけ。
      token は MSI に焼き込まない (repo も Release も public なので)。Secure="yes" が無いと
      コマンドラインの property が昇格後の execute sequence に渡らず条件が常に偽になる。
    -->
    <Property Id="ENROLLMENTTOKEN" Secure="yes" />
    <ComponentGroup Id="ChromeEnrollment" Directory="INSTALLFOLDER">
      <Component Bitness="always64" Condition="ALLUSERS=1 AND ENROLLMENTTOKEN">
        <RegistryValue Root="HKLM"
                       Key="Software\Policies\Google\Chrome"
                       Name="CloudManagementEnrollmentToken"
                       Type="string"
                       KeyPath="yes"
                       Value="[ENROLLMENTTOKEN]" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="GitHub Actions Live">
      <ComponentGroupRef Id="ExtensionFiles" />
      <ComponentGroupRef Id="UpdaterFiles" />
      <ComponentGroupRef Id="NativeHost" />
      <ComponentGroupRef Id="ChromePolicy" />
      <ComponentGroupRef Id="ChromeEnrollment" />
    </Feature>
  </Package>
</Wix>
