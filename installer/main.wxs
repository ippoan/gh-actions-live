<?xml version="1.0" encoding="utf-8"?>
<!--
  perMachine MSI (インストール時に UAC 昇格が要る)。やることは 2 つ:

    1. Chrome の ExtensionSettings ポリシーを HKLM に書いて拡張を force_installed にする
    2. 拡張一式を Program Files にも置く (ポリシー経路が使えないときの手動読み込み用)

  **なぜ perMachine か**: Windows は `HKCU\Software\Policies` に ACL をかけており、
  ユーザー権限では書き込めない (ユーザーが自分にポリシーを適用できないようにするため)。
  perUser MSI だと install 時に
  「値 installation_mode をキー ...\ExtensionSettings\<id> に書き込めません」で失敗する。
  ポリシーを使う以上 HKLM しか選択肢が無い。

  ポリシー反映には Chrome の再起動が要る。
  副作用: Chrome に「組織によって管理されています」が出る。force_installed の拡張は
  ユーザーが Chrome から削除できない (アンインストールは MSI から。ForceDeleteOnUninstall
  でポリシーキーも消える)。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="GitHub Actions Live"
      Manufacturer="ippoan"
      Version="$(var.Version)"
      UpgradeCode="63AA7341-F629-4E7E-AC1D-CEDB0D51C6F5"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="より新しいバージョンが既にインストールされています。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="gh-actions-live">
        <Directory Id="EXTFOLDER" Name="extension" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ExtensionFiles" Directory="EXTFOLDER">
      <Files Include="..\extension\**" />
    </ComponentGroup>

    <!--
      Chrome ポリシーによる強制インストール。

      **書式が重要**: ExtensionSettings は dictionary policy で、Windows では
      `Chrome` キー直下の **単一 REG_SZ に JSON を丸ごと**入れる形でしか読まれない。
      拡張 ID のサブキー + 個別値として書くと、レジストリには入るが Chrome は
      完全に無視する (chrome://policy に一切出ない)。実機で確認済み。

      ExtensionInstallForcelist (1 から連番の list policy) を使えば衝突しない書き方も
      できるが、他製品が "1" を使っていると壊れるため採らない。単一値である以上、
      他製品が同じ ExtensionSettings を使っていれば上書きになる点は許容する。

      Bitness="always64": 32bit component だと 64bit Windows で
      HKLM\Software\WOW6432Node\Policies\... に落ちて 64bit Chrome が読まない。

      アンインストール時はこの値だけが消える。Chrome キー自体は他ポリシーが
      同居しうるので ForceDeleteOnUninstall は付けない。
    -->
    <ComponentGroup Id="ChromePolicy" Directory="INSTALLFOLDER">
      <Component Bitness="always64">
        <RegistryValue Root="HKLM"
                       Key="Software\Policies\Google\Chrome"
                       Name="ExtensionSettings"
                       Type="string"
                       KeyPath="yes"
                       Value="{&quot;oaadakmclelmnaieokjbhldfacfckaaj&quot;:{&quot;installation_mode&quot;:&quot;force_installed&quot;,&quot;update_url&quot;:&quot;https://github.com/ippoan/gh-actions-live/releases/latest/download/update.xml&quot;}}" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="GitHub Actions Live">
      <ComponentGroupRef Id="ExtensionFiles" />
      <ComponentGroupRef Id="ChromePolicy" />
    </Feature>
  </Package>
</Wix>
