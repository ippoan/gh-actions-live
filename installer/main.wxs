<?xml version="1.0" encoding="utf-8"?>
<!--
  perMachine MSI (インストール時に UAC 昇格が要る)。やることは 2 つ:

    1. Chrome の ExtensionSettings ポリシーを HKLM に書いて拡張を force_installed にする
    2. 拡張一式を Program Files にも置く (ポリシー経路が使えないときの手動読み込み用)

  **なぜ perMachine か**: Windows は `HKCU\Software\Policies` に ACL をかけており、
  ユーザー権限では書き込めない (ユーザーが自分にポリシーを適用できないようにするため)。
  perUser MSI だと install 時に
  「値 installation_mode をキー ...\ExtensionSettings\<id> に書き込めません」で失敗する。
  ポリシーを使う以上 HKLM しか選択肢が無い。

  ポリシー反映には Chrome の再起動が要る。
  副作用: Chrome に「組織によって管理されています」が出る。force_installed の拡張は
  ユーザーが Chrome から削除できない (アンインストールは MSI から。ForceDeleteOnUninstall
  でポリシーキーも消える)。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="GitHub Actions Live"
      Manufacturer="ippoan"
      Version="$(var.Version)"
      UpgradeCode="63AA7341-F629-4E7E-AC1D-CEDB0D51C6F5"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="より新しいバージョンが既にインストールされています。" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="gh-actions-live">
        <Directory Id="EXTFOLDER" Name="extension" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ExtensionFiles" Directory="EXTFOLDER">
      <Files Include="..\extension\**" />
    </ComponentGroup>

    <!--
      Chrome ポリシーによる強制インストール。
      ExtensionInstallForcelist は 1 から連番で読まれる list policy なので、他製品が
      既に "1" を使っていると衝突する。ExtensionSettings は拡張 ID を key にした
      dictionary なので衝突しない — こちらを使う。

      Bitness="always64" が要る。既定だと 64bit Windows で
      HKLM\Software\WOW6432Node\Policies\... に落ちてしまい、64bit Chrome が読まない。
    -->
    <ComponentGroup Id="ChromePolicy" Directory="INSTALLFOLDER">
      <Component Bitness="always64">
        <RegistryKey Root="HKLM"
                     Key="Software\Policies\Google\Chrome\ExtensionSettings\oaadakmclelmnaieokjbhldfacfckaaj"
                     ForceDeleteOnUninstall="yes">
          <RegistryValue Name="installation_mode" Type="string" Value="force_installed" KeyPath="yes" />
          <RegistryValue Name="update_url" Type="string"
                         Value="https://github.com/ippoan/gh-actions-live/releases/latest/download/update.xml" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="GitHub Actions Live">
      <ComponentGroupRef Id="ExtensionFiles" />
      <ComponentGroupRef Id="ChromePolicy" />
    </Feature>
  </Package>
</Wix>
